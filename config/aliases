# Base64 encode username:password and copy to clipboard
b64() {
  if [[ $# -ne 2 ]]; then
    echo "Usage: b64 <username> <password>"
    return 1
  fi
  echo -n "$1:$2" | base64 | pbcopy
  echo "Base64 encoded credentials copied to clipboard"
}

