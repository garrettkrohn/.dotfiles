# Interactive environment switcher with fzf
setenv() {
  local selected
  selected=$("$HOME/dotfiles/config/scripts/setenv.sh")

  if [[ -n "$selected" ]]; then
    repo-env "$selected"
  else
    echo "No environment selected"
    return 1
  fi
}

