# ============================================================================
# Treekanga (Git Worktree Manager)
# ============================================================================
settkd() {
  local selected=$(find ~/code/treekanga_work -mindepth 1 -maxdepth 1 -type d | fzf --prompt="Select Treekanga worktree: ")
  if [ -n "$selected" ]; then
    export TREEKANGA_WORKTREE="$selected"
    echo "TREEKANGA_WORKTREE set to: $selected"
  fi
}
alias tkd='"${TREEKANGA_WORKTREE}/treekanga"'
