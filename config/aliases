tkc() {
  local selected=$(tk2 list -p -e 2>/dev/null | fzf --height 40% --reverse --border --header "Select worktree/directory")
  if [ -n "$selected" ]; then
    if [ -n "$TMUX" ]; then
      tk2 --log error connect --switch "$selected"
    else
      tk2 --log error connect "$selected"
    fi
  fi
}

